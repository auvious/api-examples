{
  "info": {
    "_postman_id": "22bfb061-3b45-4af0-91b1-6e9f6b9b1a0e",
    "name": "Auvious Recording",
    "description": "API steps to join a conference and start recording. Use an existing conference_id from the Rooms collection or create one here.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth: Get Access Token",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/x-www-form-urlencoded"
          }
        ],
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "grant_type",
              "value": "client_credentials",
              "type": "text"
            },
            {
              "key": "client_id",
              "value": "{{client_id}}",
              "type": "text"
            },
            {
              "key": "client_secret",
              "value": "{{client_secret}}",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{base_url}}/security/oauth/token",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "security",
            "oauth",
            "token"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status is OK\", function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const jsonData = pm.response.json();",
              "pm.environment.set(\"access_token\", jsonData.access_token);",
              "if (jsonData.expires_in) {",
              "  pm.environment.set(\"token_expires_in\", jsonData.expires_in);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "RTC: Create Conference (optional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conferenceId\": \"{{$guid}}\",\n  \"interactionId\": \"{{interaction_id}}\",\n  \"metadata\": {\n    \"participant_limit\": \"8\"\n  },\n  \"mode\": \"ROUTER\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/rtc-api/conferences/create",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rtc-api",
            "conferences",
            "create"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get(\"interaction_id\")) {",
              "  const iid = pm.variables.replaceIn(\"{{$guid}}\");",
              "  pm.environment.set(\"interaction_id\", iid);",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Conference created\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const res = pm.response.json();",
              "const confId = res.id || res.conferenceId;",
              "pm.environment.set(\"conference_id\", confId);"
            ]
          }
        }
      ]
    },
    {
      "name": "RTC: Register Endpoint",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"keepAliveSeconds\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/rtc-api/users/endpoints",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rtc-api",
            "users",
            "endpoints"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Endpoint registered\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const res = pm.response.json();",
              "const id = typeof res === 'string' ? res : res.id;",
              "pm.environment.set(\"user_endpoint_id\", id);"
            ]
          }
        }
      ]
    },
    {
      "name": "RTC: Join Conference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conferenceId\": \"{{conference_id}}\",\n  \"userEndpointId\": \"{{user_endpoint_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/rtc-api/conferences/join",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rtc-api",
            "conferences",
            "join"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get(\"conference_id\")) {",
              "  throw new Error(\"conference_id is empty. Use Rooms collection or run Create Conference here.\");",
              "}",
              "if (!pm.environment.get(\"user_endpoint_id\")) {",
              "  throw new Error(\"user_endpoint_id is empty. Run Register Endpoint first.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Joined conference\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Recording: Start",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"applicationId\": \"{{application_id}}\",\n  \"conferenceId\": \"{{conference_id}}\",\n  \"conversationId\": \"{{interaction_id}}\",\n  \"audio\": true,\n  \"video\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/rtc-recorder/api/recordings/start",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rtc-recorder",
            "api",
            "recordings",
            "start"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get(\"interaction_id\")) {",
              "  const iid = pm.variables.replaceIn(\"{{$guid}}\");",
              "  pm.environment.set(\"interaction_id\", iid);",
              "}",
              "if (!pm.environment.get(\"conference_id\")) {",
              "  throw new Error(\"conference_id is empty. Use Rooms collection or run Create Conference here.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Recording started\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "});",
              "const res = pm.response.json();",
              "if (res.recorderId) pm.environment.set(\"recorder_id\", res.recorderId);",
              "if (res.instanceId) pm.environment.set(\"recorder_instance_id\", res.instanceId);"
            ]
          }
        }
      ]
    },
    {
      "name": "RTC: Set RECORDER metadata (optional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conferenceId\": \"{{conference_id}}\",\n  \"operation\": \"SET\",\n  \"key\": \"RECORDER\",\n  \"value\": \"{\\\"on\\\":true}\",\n  \"userEndpointId\": \"{{user_endpoint_id}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/rtc-api/conferences/updateMetadata",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rtc-api",
            "conferences",
            "updateMetadata"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get(\"conference_id\")) {",
              "  throw new Error(\"conference_id is empty. Use Rooms collection or run Create Conference here.\");",
              "}",
              "if (!pm.environment.get(\"user_endpoint_id\")) {",
              "  throw new Error(\"user_endpoint_id is empty. Run Register Endpoint and Join first.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Metadata set\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "RTC: Leave Conference",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"conferenceId\": \"{{conference_id}}\",\n  \"userEndpointId\": \"{{user_endpoint_id}}\",\n  \"reason\": \"completed via Postman\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/rtc-api/conferences/leave",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "rtc-api",
            "conferences",
            "leave"
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "if (!pm.environment.get(\"conference_id\")) {",
              "  throw new Error(\"conference_id is empty. Use Rooms collection or run Create Conference here.\");",
              "}",
              "if (!pm.environment.get(\"user_endpoint_id\")) {",
              "  throw new Error(\"user_endpoint_id is empty. Run Register Endpoint and Join first.\");",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Left conference\", function () {",
              "  pm.expect(pm.response.code).to.be.oneOf([200, 204]);",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
